{
  "name": "moyu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "verify:foundation": "node --env-file-if-exists=.env scripts/verify-foundation.mjs",
    "verify:workspace:boundary": "node scripts/verify-workspace.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs && vitest run src/client/workspace scripts/verify-workspace.test.ts && playwright test tests/e2e/workspace-shell.spec.ts tests/e2e/workspace.spec.ts tests/e2e/workspace-responsive.spec.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.40.0",
    "next": "^16.0.0",
    "nodemailer": "^9.1.1",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.0.0",
    "shadcn": "4.20.1",
    "smtp-server": "^3.19.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
