NODE_ENV=development
# Production: NODE_ENV=production and APP_ORIGIN=https://your-domain.example
# DATABASE_URL must reach PostgreSQL from the app container (not its localhost).
DATABASE_URL=postgresql://moyu:moyu@localhost:5432/moyu
APP_ORIGIN=http://localhost:3000
# Enable only behind an ingress that overwrites X-Forwarded-For with one client IP.
# Keep the application port private. False ignores all forwarded headers safely.
TRUST_PROXY=false
AUTH_COOKIE_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
# Local capture values only; configure your authenticated SMTP provider in production.
# Port 465 uses implicit TLS. Other production ports require STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=moyu
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=moyu@example.test
# Optional private health URL for local release validation behind HTTPS ingress.
# verify:foundation still validates a production HTTPS APP_ORIGIN.
# FOUNDATION_HEALTH_URL=http://127.0.0.1:3100/api/health
