NODE_ENV=development
DATABASE_URL=postgresql://moyu:moyu@localhost:5432/moyu
APP_ORIGIN=http://localhost:3000
# Enable only behind an ingress that overwrites X-Forwarded-For with one client IP.
# Keep the application port private. False ignores all forwarded headers safely.
TRUST_PROXY=false
AUTH_COOKIE_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=moyu
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=moyu@example.test
